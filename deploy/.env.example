# Copy to deploy/.env, fill in, and `chmod 600 deploy/.env`. Never commit .env (it is in .gitignore).
# Every variable the stack reads is here.

# --- Host name -----------------------------------------------------------------------------------------------
# The public host name, e.g. a free DuckDNS name: myname.duckdns.org (pointing at this server's public IP).
APP_HOST=myname.duckdns.org

# --- Size ----------------------------------------------------------------------------------------------------
# standard = 12 GB host, small = 4 GB host (see deploy/profiles/). deploy.sh reads it.
PROFILE=standard

# --- Secrets (generate the random ones with: openssl rand -base64 33 | tr -d '/+=' ) ---------------------------
POSTGRES_PASSWORD=change-me
# Seals the one-time download links. Any long random string.
APP_STORAGE_LINK_SECRET=change-me
# The Anthropic API key (console.anthropic.com). Only the worker uses it.
ANTHROPIC_API_KEY=

# --- Sign-in -------------------------------------------------------------------------------------------------
# Sign in with Google: create an OAuth client (Web application) in the Google Cloud console with the redirect URI
#   https://<APP_HOST>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-in needs a domain to send from: leave it off for now.
APP_MAIL_MODE=off
APP_MAIL_FROM=noreply@localhost

# --- Backups (backup.sh) -------------------------------------------------------------------------------------
# The PUBLIC key from `age-keygen` (starts with age1...). The private key must never be on this server.
BACKUP_AGE_RECIPIENT=
# Where backups are kept on the server. The last 7 are kept.
BACKUP_DIR=/var/backups/variant

# --- Optional overrides ----------------------------------------------------------------------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
# SITE_DIR=./site
