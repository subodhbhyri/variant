{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Every error body is {code, message, details}. The frontend must handle every code.",
    "title" : "Resume Tailor API",
    "version" : "6.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/auth/csrf" : {
      "get" : {
        "operationId" : "csrf",
        "responses" : {
          "204" : {
            "description" : "The cookie is set."
          }
        },
        "summary" : "Sets the CSRF cookie (XSRF-TOKEN); send its value back in the X-XSRF-TOKEN header on every POST, PUT and DELETE.",
        "tags" : [ "auth-controller" ]
      }
    },
    "/auth/email" : {
      "post" : {
        "operationId" : "requestEmailLink",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            },
            "description" : "If the address is valid, a link is on its way."
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "INVALID_EMAIL"
          },
          "429" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "RATE_LIMITED: 5 links per address and 20 per IP per hour."
          }
        },
        "summary" : "Sends a sign-in link by email. Always 202 for a valid address, whether or not it has an account, so it can't be used to probe accounts.",
        "tags" : [ "auth-controller" ]
      }
    },
    "/auth/email/verify" : {
      "get" : {
        "operationId" : "confirmEmailLink",
        "parameters" : [ {
          "in" : "query",
          "name" : "token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The confirmation page (text/html)."
          },
          "302" : {
            "description" : "Redirect to the app's sign-in page: the link is not valid."
          }
        },
        "summary" : "Shows a confirmation page for a sign-in link (\"Continue as {email}\", one button) WITHOUT spending the link: email scanners open links before people do. A bad, used or expired link redirects to {app}/signin?error=SIGNIN_LINK_INVALID.",
        "tags" : [ "auth-controller" ]
      },
      "post" : {
        "operationId" : "verifyEmailLink",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : { }
              }
            },
            "description" : "Signed in."
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "SIGNIN_LINK_INVALID"
          }
        },
        "summary" : "Spends a sign-in link (single use, 15 minutes) and starts the session. JSON {\"token\"} gets 200 {\"redirect\"}; the confirmation page's form post gets a redirect to the app. A bad, used or expired link is 400 SIGNIN_LINK_INVALID (or a redirect to {app}/signin?error=SIGNIN_LINK_INVALID). CSRF-protected like every other POST.",
        "tags" : [ "auth-controller" ]
      }
    },
    "/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "Signed out (also when there was no session)."
          }
        },
        "summary" : "Ends the session.",
        "tags" : [ "auth-controller" ]
      }
    },
    "/config" : {
      "get" : {
        "operationId" : "getConfig",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PublicConfig"
                }
              }
            },
            "description" : "The enabled sign-in methods."
          }
        },
        "summary" : "Public, no session: the sign-in methods that are switched on (\"google\", \"email\").",
        "tags" : [ "config-controller" ]
      }
    },
    "/healthz" : {
      "get" : {
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Liveness check for the load balancer",
        "tags" : [ "health-controller" ]
      }
    },
    "/jobs/{id}" : {
      "get" : {
        "operationId" : "getJob",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND (also for another user's job)"
          }
        },
        "summary" : "A job's status (queued, running, succeeded, failed), progress, result and error code.",
        "tags" : [ "job-controller" ]
      }
    },
    "/jobs/{id}/events" : {
      "get" : {
        "operationId" : "getJobEvents",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND (also for another user's job)"
          },
          "429" : {
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "TOO_MANY_STREAMS: at most 5 open streams per user"
          }
        },
        "summary" : "Server-sent events with the same JobView, sent as the job changes; the stream ends when the job is succeeded or failed.",
        "tags" : [ "job-controller" ]
      }
    },
    "/libraries/{id}/variants/{vid}/remove" : {
      "post" : {
        "operationId" : "removeVariant",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "vid",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "LIBRARY_STALE"
          }
        },
        "summary" : "Removes a generated variant the user doesn't stand behind. Writes a new library version; the version they were looking at stays unchanged. Only the newest version can be changed.",
        "tags" : [ "generation-controller" ]
      }
    },
    "/me" : {
      "delete" : {
        "operationId" : "deleteMe",
        "responses" : {
          "204" : {
            "description" : "Deleted."
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "UNAUTHENTICATED"
          }
        },
        "summary" : "Deletes the account and all its data. Database rows go at once; stored files within 24 hours.",
        "tags" : [ "me-controller" ]
      },
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "UNAUTHENTICATED"
          }
        },
        "summary" : "The signed-in user, their active resume id (null if none) and a usage summary.",
        "tags" : [ "me-controller" ]
      }
    },
    "/postings" : {
      "get" : {
        "operationId" : "listPostings",
        "parameters" : [ {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PostingSummary"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The user's postings, newest first.",
        "tags" : [ "posting-controller" ]
      },
      "post" : {
        "operationId" : "createPosting",
        "parameters" : [ {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PostingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : { }
              }
            },
            "description" : "Cache hit: the match."
          },
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : { }
              }
            },
            "description" : "Matching queued."
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NO_ACTIVE_RESUME or NO_LIBRARY"
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "JD_TOO_LONG or another posting problem"
          },
          "429" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "POSTING_LIMIT: 200 postings a day"
          }
        },
        "summary" : "Adds a job posting (text, at most 20,000 characters) and matches it against the active resume's newest library. A cache hit (same library version and a same or near-identical posting) is answered at once with 200 and the match; otherwise 202 with a job to follow.",
        "tags" : [ "posting-controller" ]
      }
    },
    "/postings/{id}/match" : {
      "get" : {
        "operationId" : "getMatch",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND (also for another user's posting)"
          }
        },
        "summary" : "The match: resume #1's snapshot, the scored alternatives, missing skills and infeasible reasons. Project ids in labels are already replaced by titles. status is pending, ready or failed.",
        "tags" : [ "posting-controller" ]
      }
    },
    "/resumes" : {
      "post" : {
        "operationId" : "uploadResume",
        "parameters" : [ {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : [ "object" ],
                "example" : null,
                "properties" : {
                  "file" : {
                    "type" : [ "string" ],
                    "format" : "binary",
                    "example" : null
                  }
                },
                "required" : [ "file" ]
              }
            }
          }
        },
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UploadResponse"
                }
              }
            },
            "description" : "Stored; onboarding queued."
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "A gate code: FILE_TOO_LARGE, ENCRYPTED_OR_LEGACY, NOT_A_DOCX, TOO_MANY_ENTRIES, DUPLICATE_ENTRY, UNSAFE_PATH, ZIP_BOMB, MACROS, EMBEDDED_OBJECT, EXTERNAL_RESOURCE, UNSAFE_XML, TRACKED_CHANGES"
          }
        },
        "summary" : "Uploads a resume (.docx, at most 2 MB, form field 'file'). The Phase 2 upload gate runs at once: a rejection is a 422 with the gate's code and nothing is stored. Otherwise the resume is stored and an onboarding job is queued.",
        "tags" : [ "resume-controller" ]
      }
    },
    "/resumes/{id}" : {
      "get" : {
        "operationId" : "getResume",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND (also for another user's resume)"
          }
        },
        "summary" : "Status, onboarding report (without bullet text), section roles, positions (blocks) and font substitutions.",
        "tags" : [ "resume-controller" ]
      }
    },
    "/resumes/{id}/accept" : {
      "post" : {
        "operationId" : "acceptResume",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AcceptRequest"
              }
            }
          }
        },
        "responses" : {
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "RESUME_NOT_READY or FONT_CHOICE_UNSUPPORTED"
          }
        },
        "summary" : "The user approves the normalized preview: the resume becomes the active one (the previous active resume is archived) and any unconfirmed section role is confirmed as suggested. font_choice is reserved for NEEDS_USER and is refused for now.",
        "tags" : [ "resume-controller" ]
      }
    },
    "/resumes/{id}/generate" : {
      "post" : {
        "operationId" : "generate",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GenerateRequest"
              }
            }
          }
        },
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GenerateResponse"
                }
              }
            },
            "description" : "Queued; follow the job."
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "RESUME_NOT_ACCEPTED, NO_INTAKE or NO_LIBRARY"
          },
          "429" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "GENERATION_LIMIT"
          }
        },
        "summary" : "Queues a generation run for the saved intake. Charges nothing in Phase 6; the cost is recorded. With 'sections', only those sections are regenerated and the rest carry over unchanged. Each run is a new library version. At most 5 runs per resume per day.",
        "tags" : [ "generation-controller" ]
      }
    },
    "/resumes/{id}/intake" : {
      "get" : {
        "operationId" : "getIntake",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "RESUME_NOT_ACCEPTED"
          }
        },
        "summary" : "The intake form: one section per job and per swappable project position, pre-filled from the resume and merged with the user's saved answers. Only saved sections are generated.",
        "tags" : [ "intake-controller" ]
      }
    },
    "/resumes/{id}/intake/projects" : {
      "post" : {
        "operationId" : "addIntakeProject",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SaveRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "INVALID_LINK, NOTES_TOO_LONG or TOO_MANY_PROJECTS"
          }
        },
        "summary" : "Adds a project (id project-new-N). At most 8: the ninth is TOO_MANY_PROJECTS.",
        "tags" : [ "intake-controller" ]
      }
    },
    "/resumes/{id}/intake/projects/{sid}" : {
      "delete" : {
        "operationId" : "removeIntakeProject",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "sid",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Removes an added project. The resume's own positions can't be removed; skip them instead.",
        "tags" : [ "intake-controller" ]
      }
    },
    "/resumes/{id}/intake/sections/{sid}" : {
      "put" : {
        "operationId" : "saveIntakeSection",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "sid",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SaveRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "INVALID_LINK, NOTES_TOO_LONG or TOO_MANY_PROJECTS"
          }
        },
        "summary" : "Saves one section: mode (DETAILED, EXISTING_ONLY, SKIPPED), header fields and notes. Refused with INVALID_LINK or NOTES_TOO_LONG (1,500 words); nothing is cut or truncated.",
        "tags" : [ "intake-controller" ]
      }
    },
    "/resumes/{id}/library" : {
      "get" : {
        "operationId" : "getLibrary",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND (also when nothing has been generated yet)"
          }
        },
        "summary" : "The newest library version: variants per section, projects, coverage and what was dropped and why.",
        "tags" : [ "generation-controller" ]
      }
    },
    "/resumes/{id}/preview" : {
      "get" : {
        "operationId" : "getResumePreview",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND"
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "RESUME_NOT_READY: onboarding hasn't produced a preview"
          }
        },
        "summary" : "A short-lived (5 minute) link to the normalized preview PDF.",
        "tags" : [ "resume-controller" ]
      }
    },
    "/resumes/{id}/sections/{key}/role" : {
      "put" : {
        "operationId" : "confirmSectionRole",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RoleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND"
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "ROLE_CHANGE_UNSUPPORTED"
          }
        },
        "summary" : "Confirms a section's role. Only the suggested role can be confirmed for now: any other role is refused with ROLE_CHANGE_UNSUPPORTED, because the engine decides roles itself.",
        "tags" : [ "resume-controller" ]
      }
    },
    "/snapshots/{id}" : {
      "get" : {
        "operationId" : "getSnapshot",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND (also for another user's snapshot)"
          }
        },
        "summary" : "A snapshot: its assembly (with project titles), status and revision chain.",
        "tags" : [ "snapshot-controller" ]
      }
    },
    "/snapshots/{id}/pdf" : {
      "get" : {
        "operationId" : "getSnapshotPdf",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "SNAPSHOT_NOT_RENDERED"
          }
        },
        "summary" : "A short-lived (5 minute) download link for the snapshot's PDF, issued only after the ownership check.",
        "tags" : [ "snapshot-controller" ]
      }
    },
    "/snapshots/{id}/render" : {
      "post" : {
        "operationId" : "renderAlternative",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : { }
              }
            },
            "description" : "Rendering queued."
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "NOT_FOUND"
          }
        },
        "summary" : "Renders an alternative on request. 202 with a job; 200 with the snapshot if it is already rendered.",
        "tags" : [ "snapshot-controller" ]
      }
    },
    "/snapshots/{id}/revisions" : {
      "post" : {
        "operationId" : "createRevision",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RevisionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Accepted"
                }
              }
            },
            "description" : "Queued: snapshot_id is the revision's id once the job succeeds."
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "EDIT_TOO_LONG or SLOT_LOCKED"
          }
        },
        "summary" : "Applies edits as a NEW snapshot (a revision of this one): the edits are applied to this snapshot's document, every one is re-checked, the whole document is verified, and only then is the revision created. The snapshot being edited never changes. If a check or the verification fails nothing is created and the job's rejected result names the slot and the reason (TOO_LONG or VERIFY_FAILED).",
        "tags" : [ "edit-controller" ]
      }
    },
    "/snapshots/{id}/slots/{slot}/check" : {
      "post" : {
        "operationId" : "checkSlot",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "slot",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CheckRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "EDIT_TOO_LONG or SLOT_LOCKED"
          },
          "429" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "RATE_LIMITED"
          }
        },
        "summary" : "Checks one bullet's new text: the parent is rendered with just that slot replaced (one render) and the verdict is FITS, FITS_WITH_PADDING or TOO_LONG. Synchronous (about a second); 30 a minute. Empty text is a blank and always fits. Text is normalized first (trimmed, newlines and tabs to spaces, spaces collapsed, at most 1,000 characters).",
        "tags" : [ "edit-controller" ]
      }
    }
  },
